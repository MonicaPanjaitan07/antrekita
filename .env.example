# === Database (Neon Postgres, gratis: https://neon.tech) ===
# Salin connection string dari dashboard Neon (pilih yang "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# === Auth ===
# Isi dengan string acak panjang, mis. hasil: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Opsional: batasi pendaftaran hanya untuk domain email tertentu (pisahkan dengan koma)
# Contoh: ALLOWED_EMAIL_DOMAINS="students.del.ac.id,del.ac.id"
ALLOWED_EMAIL_DOMAINS=""

# === Google Gemini (gratis: https://aistudio.google.com/apikey) ===
GEMINI_API_KEY=""
# Model yang dipakai (boleh diganti ke model Gemini terbaru yang mendukung function calling & gambar)
GEMINI_MODEL="gemini-2.5-flash"

# === Data awal (seed otomatis saat deploy; aman dijalankan berulang) ===
# Akun petugas pertama — GANTI password ini sebelum deploy!
SEED_STAFF_EMAIL="petugas@antrekita.id"
SEED_STAFF_PASSWORD="petugas123"
# Isi "false" untuk TIDAK membuat akun mahasiswa demo & contoh booking (mis. saat dipakai sungguhan)
SEED_DEMO_DATA="true"
